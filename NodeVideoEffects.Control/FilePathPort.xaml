<UserControl x:Class="NodeVideoEffects.Control.FilePathPort"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:control="clr-namespace:NodeVideoEffects.Control"
             mc:Ignorable="d"
             MinHeight="30" Width="auto" MinWidth="100" MaxWidth="220"
             d:DataContext="{d:DesignInstance {x:Type control:FilePathPort},IsDesignTimeCreatable=True}">
    <UserControl.Resources>
        <ResourceDictionary Source="Style/Style.xaml" />
    </UserControl.Resources>
    <Grid>
        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
            <Button Content="選択" Click="OpenFileDialog" VerticalAlignment="Center" VerticalContentAlignment="Center" />
            <TextBlock Text="{Binding PathFileText}"
                       ToolTip="{Binding Value}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap"
                       HorizontalAlignment="Left" />
        </StackPanel>
    </Grid>
</UserControl>